#!/bin/bash


if ! [ "${MAIL_RELAY_HOST}" = "" ]; then
    postconf -e "relayhost = ${MAIL_RELAY_HOST}"
fi
if ! [ "${MAIL_RELAY_USERNAME}" = "" ]; then
    # Keyed on the exact relayhost value; kept out of the world-readable main.cf
    SASL_DB_TYPE=$(postconf -h default_database_type)
    umask 077
    printf '%s %s:%s\n' "${MAIL_RELAY_HOST}" "${MAIL_RELAY_USERNAME}" "${MAIL_RELAY_PASSWORD}" > /etc/postfix/sasl_passwd
    umask 022
    postmap "${SASL_DB_TYPE}:/etc/postfix/sasl_passwd"
    postconf -e "smtp_tls_security_level = encrypt"
    postconf -e "smtp_sasl_auth_enable = yes"
    postconf -e "smtp_sasl_password_maps = ${SASL_DB_TYPE}:/etc/postfix/sasl_passwd"
    postconf -e "smtp_sasl_security_options = noanonymous"
    postconf -e "smtp_sasl_tls_security_options = noanonymous"
fi
if ! [ "${MAIL_INET_PROTOCOLS}" = "" ]; then 
    postconf -e "inet_protocols = ${MAIL_INET_PROTOCOLS}"
fi
postconf -e "myhostname = $(hostname)"
postconf -e "mydestination = ${NAGIOS_FQDN}, \$myhostname, localhost.localdomain, localhost"

postconf -X myorigin
echo "${NAGIOS_FQDN}" > /etc/mailname

#postfix runs in a chroot and needs resolv.conf to resolve hostnames
cp /etc/resolv.conf /var/spool/postfix/etc/resolv.conf

exec /usr/lib/postfix/sbin/master -d -c /etc/postfix
